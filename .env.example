# Backend API base URL (used by axiosClient and server-side fetches)
BACKEND_BASE_URL_DOMAIN=http://localhost:5000/api/v1

# Public URL of this frontend (metadata, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment flag exposed to the browser
NEXT_PUBLIC_NODE_ENV=development

# Maintenance mode (optional)
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_COUNTDOWN_SECONDS=900

# Serve mock data from APIKit until the ByteSpace backend is ready
NEXT_PUBLIC_USE_MOCK_API=true
