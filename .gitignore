# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ────────────────────────────────────────────────
/.next/
/out/
/build
/dist
next-env.d.ts

# ─── TypeScript / tooling caches ───────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.turbo
.vercel

# ─── Testing ───────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ─── Environment variables ─────────────────────────────────────────────────
# Real values never get committed; .env.example documents the variables.
.env*
!.env.example

# ─── Secrets / certificates ────────────────────────────────────────────────
*.pem
*.key
*.crt

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors ───────────────────────────────────────────────────────────────
# Keep the shared VS Code workspace settings / recommended extensions only.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Files
/Ofiles
/design-tokens
/ui
GUIDE.md
Project.md